<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GRC.Infrastructure\GRC.Infrastructure.csproj" />
    <ProjectReference Include="..\GRC.Application\GRC.Application.csproj" />
    <ProjectReference Include="..\GRC.Domain\GRC.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Tresorerie.Core">
      <HintPath>..\libs\Tresorerie.Core.dll</HintPath>
    </Reference>
    <Reference Include="Tresorerie.Dapper">
      <HintPath>..\libs\Tresorerie.Dapper.dll</HintPath>
    </Reference>
    <Reference Include="Dapper">
      <HintPath>..\libs\Dapper.dll</HintPath>
    </Reference>
    <Reference Include="DapperExtensions">
      <HintPath>..\libs\Tresorerie\DapperExtensions.dll</HintPath>
    </Reference>
    <Reference Include="Tresorerie.ApplicationServices">
      <HintPath>..\libs\Tresorerie\Tresorerie.ApplicationServices.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\libs\Tresorerie\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
